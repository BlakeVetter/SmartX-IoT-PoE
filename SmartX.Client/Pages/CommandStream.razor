        font-weight: 800;
    }

    .p2-brand small {
        display: block;
        font-size: 10px;
        letter-spacing: 2px;
        color: #8799ae;
    }

    .p2-logo {
        background: #b7ff4a;
        color: #080d17;
        border-radius: 10px;
        padding: 7px 14px;
        font-size: 28px;
    }

    .p2-connect {
        font-size: 11px;
        color: #9cafc6;
        letter-spacing: 1px;
    }

    .p2-indicator {
        display: inline-block;
        background: #ff8b91;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-right: 8px;
    }

    .p2-indicator.connected { background: #b7ff4a; }

    .p2-nav {
        justify-content: flex-start;
        flex-wrap: wrap;
        padding: 17px 0;
        border-bottom: 1px solid #26364b;
        gap: 30px;
        font-size: 11px;
        font-weight: 750;
    }

    .p2-nav a, .p2-nav span {
        color: #8395a9;
        text-decoration: none;
    }

    .p2-nav a.active, .p2-nav a:hover { color: #b7ff4a; }

    .p2-hero {

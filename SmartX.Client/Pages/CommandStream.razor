        gap: 16px;
        margin-bottom: 22px;
    }

    .p2-card, .p2-panel {
        background: linear-gradient(140deg, #131f30, #0d1726);
        border: 1px solid #2c3c50;
        border-radius: 14px;
    }

    .p2-card {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .p2-card small { color: #9badc4; font-size: 11px; }
    .p2-card strong { font-size: 36px; }
    .p2-card span { color: #8c9fb5; font-size: 12px; }

    .p2-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    .p2-panel { padding: 23px; min-width: 0; }
    .p2-title { align-items: flex-start; margin-bottom: 20px; }
    .p2-title h2 { font-size: 21px; margin: 7px 0 0; }

    .p2-tag {

    .p2-count {
        background: #682c3c;
        border-radius: 20px;
        padding: 4px 7px;
        font-size: 11px;
    }

    .p2-btn {
        border: 0;
        padding: 13px 16px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 11px;
        cursor: pointer;
    }

    .p2-btn.primary { background: #b7ff4a; color: #101917; }
    .p2-btn.outline {
        border: 1px solid #477075;
        background: #193039;
        color: #b7ff4a;
    }

    .p2-btn.full { width: 100%; margin-top: 12px; }
    .p2-btn:disabled { opacity: .45; cursor: not-allowed; }

    .p2-device-state {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        border: 1px solid #2b4458;
        background: #111f2b;
        border-radius: 9px;
        padding: 13px;
        margin: 16px 0;
        color: #a3b6cb;
        font-size: 12px;
        flex-wrap: wrap;
    }

    .p2-device-state b { color: #b7ff4a; }
    .p2-scroll { max-height: 370px; overflow: auto; }

    .p2-alert, .p2-command, .p2-suggestion {
        border-bottom: 1px solid #2c3d51;
        padding: 12px 0;
    }

    .p2-alert { display: flex; gap: 13px; }

    .p2-alert-mark {
        height: 27px;
        width: 27px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: #6b3038;
        color: #ffafb7;
        font-weight: 800;
    }

    .p2-alert strong, .p2-command strong,
    .p2-suggestion strong { font-size: 12px; }

    .p2-alert small, .p2-command small {
        display: block;
        font-size: 11px;
        color: #93a5b9;
        margin-top: 5px;
    }

    .p2-alert .p2-danger { margin-left: 8px; font-size: 10px; }

    .p2-suggestion p {
        color: #9fb1c5;
        font-size: 12px;
        line-height: 1.6;
    }

    .p2-command strong span { margin-left: 8px; font-size: 10px; }

    .p2-notice {
        border: 1px solid #47716a;
        background: #153034;
        color: #c8f3dd;
        padding: 13px;
        border-radius: 8px;
        margin-bottom: 20px;
        overflow-wrap: anywhere;
    }

    .p2-table-wrap { overflow: auto; }

    .p2-table {
        border-collapse: collapse;
        width: 100%;
        min-width: 540px;
    }

    .p2-table th, .p2-table td {
        padding: 13px 9px;
        text-align: left;
        border-bottom: 1px solid #293b51;


@page "/command-stream"
@using SmartX.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject HttpClient Http

<PageTitle>Smart-X | Command Stream</PageTitle>

<div class="p2-page">
    <header class="p2-header">
        <a href="/" class="p2-brand">
            <span class="p2-logo">X</span>
            <span>
                SMART<span class="p2-accent">-X</span>
                <small>REAL-TIME CONTROL CENTRE</small>
            </span>
        </a>

        <span class="p2-connect">
            <span class="p2-indicator @(connected ? "connected" : "")"></span>
            @(connected ? "API CONNECTED" : "API DISCONNECTED")
        </span>
    </header>

    <nav class="p2-nav">
        <NavLink href="/" Match="NavLinkMatch.All">
            01 / SENSOR INGESTION
        </NavLink>
        <NavLink href="/command-stream">
            02 / COMMAND STREAM
        </NavLink>
        <span>03 / MESH TOPOLOGY — FINAL POE</span>
    </nav>

    <section class="p2-hero">
        <div>
            <span class="p2-eyebrow">
                PART 02 / REAL-TIME PROCESSING
            </span>
            <h1>Live Command <span class="p2-accent">Stream.</span></h1>
            <p>
                Monitor telemetry, prioritise critical alerts,
                override device states and undo commands instantly.
            </p>
        </div>

        <button class="p2-btn primary"
                @onclick="SimulateAsync"
                disabled="@busy">
            + GENERATE TELEMETRY
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="p2-notice" role="status">@message</div>
    }

    <section class="p2-stats">
        <div class="p2-card">
            <small>REGISTERED NODES</small>
            <strong>@data.Devices.Count</strong>
            <span>Live device dictionary</span>
        </div>

        <div class="p2-card">
            <small>PROCESSED PACKETS</small>
            <strong>@data.ProcessedPackets</strong>
            <span>FIFO queue completed</span>
        </div>

        <div class="p2-card">
            <small>WAITING PACKETS</small>
            <strong>@data.QueuedPackets</strong>
            <span>FIFO queue backlog</span>
        </div>

        <div class="p2-card">
            <small>ACTIVE ALERTS</small>
            <strong class="p2-danger">@data.ActiveAlertCount</strong>
            <span>Unique error states</span>
        </div>
    </section>

    <div class="p2-grid">

        <section class="p2-panel">
            <div class="p2-title">
                <div>
                    <small>DEVICE DISCOVERY</small>
                    <h2>Device registry</h2>
                </div>
                <span class="p2-tag">DICTIONARY LOOKUP</span>
            </div>

            <div class="p2-filter">
                <input aria-label="Search devices"
                       placeholder="Search ID or location..."
                       @bind="search"
                       @bind:event="oninput" />

                <select aria-label="Filter by category"
                        @bind="categoryFilter">
                    <option value="All">All categories</option>
                    <option value="Environmental">Environmental</option>
                    <option value="Power">Power</option>
                    <option value="Actuator">Actuator</option>
                </select>
            </div>

            <label class="p2-check">
                <input type="checkbox" @bind="alertsOnly" />
                Show devices with active alerts only
            </label>

            <div class="p2-devices">
                @foreach (var device in FilteredDevices)
                {
                    <button class="p2-device @(device.DeviceId == selectedDevice ? "selected" : "")"
                            @onclick="() => ChooseDevice(device.DeviceId)">

                        <span class="p2-device-icon">◈</span>

                        <span class="p2-device-text">
                            <strong>@device.DeviceId</strong>
                            <small>@device.Location</small>
                        </span>

                        <span class="p2-state @(device.IsOnline ? "ok" : "bad")">
                            @(device.IsOnline ? "ONLINE" : "OFFLINE")
                        </span>

                        @if (device.ActiveAlerts > 0)
                        {
                            <span class="p2-count">@device.ActiveAlerts</span>
                        }
                    </button>
                }

                @if (FilteredDevices.Count == 0)
                {
                    <p class="p2-muted">No devices match these filters.</p>
                }
            </div>
        </section>

        <section class="p2-panel">
            <div class="p2-title">
                <div>
                    <small>MANUAL OVERRIDE</small>
                    <h2>Device commands</h2>
                </div>
                <span class="p2-tag">STACK / UNDO</span>
            </div>

            <label class="p2-label">TARGET DEVICE</label>

            <select class="p2-input"
                    @bind="selectedDevice"
                    @bind:after="ChooseDefaultAction">

                @foreach (var device in data.Devices)
                {
                    <option value="@device.DeviceId">
                        @device.DeviceId — @device.Category
                    </option>
                }
            </select>

            <label class="p2-label">COMMAND</label>

            <select class="p2-input" @bind="selectedAction">
                @foreach (var action in AvailableActions)
                {
                    <option value="@action">@action.Replace('_', ' ')</option>
                }
            </select>

            @if (SelectedDevice is not null)
            {
                <div class="p2-device-state">
                    <span>Pump <b>@(SelectedDevice.PumpOn ? "ON" : "OFF")</b></span>
                    <span>Relay <b>@(SelectedDevice.RelayOn ? "ON" : "OFF")</b></span>
                    <span>Valve <b>@(SelectedDevice.ValveOpen ? "OPEN" : "CLOSED")</b></span>
                </div>
            }

            <button class="p2-btn primary full"
                    disabled="@(busy || SelectedDevice is null)"
                    @onclick="SendCommandAsync">
                ISSUE OVERRIDE COMMAND
            </button>

            <button class="p2-btn outline full"
                    disabled="@(busy || !data.CanUndo)"
                    @onclick="UndoAsync">
                ↶ UNDO LAST COMMAND
            </button>

            <p class="p2-muted">
                Commands change simulated device states.
                Undo restores the previous state using a LIFO stack.
            </p>
        </section>
    </div>

    <div class="p2-grid">

        <section class="p2-panel">
            <div class="p2-title">
                <div>
                    <small>PRIORITY QUEUE / HASHSET</small>
                    <h2>Critical alerts</h2>
                </div>
                <span class="p2-tag">CRITICAL FIRST</span>
            </div>

            <div class="p2-scroll">
                @foreach (var alert in data.Alerts.Take(10))
                {
                    <div class="p2-alert">
                        <span class="p2-alert-mark">!</span>
                        <div>
                            <strong>
                                @alert.DeviceId
                                <span class="p2-danger">@alert.Severity</span>
                            </strong>

                            <small>@alert.Message</small>

                            <small>
                                @alert.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")
                                • @(alert.IsActive ? "ACTIVE" : "RESOLVED")
                            </small>
                        </div>
                    </div>
                }

                @if (data.Alerts.Count == 0)
                {
                    <p class="p2-muted">
                        No alert events yet. Generate telemetry
                        to test priority processing.
                    </p>
                }
            </div>
        </section>

        <section class="p2-panel">
            <div class="p2-title">
                <div>
                    <small>PATTERN ANALYSIS</small>
                    <h2>Suggested actions</h2>
                </div>
                <span class="p2-tag">AUTOMATED INSIGHTS</span>
            </div>

            <div class="p2-scroll">
                @foreach (var suggestion in data.Suggestions)
                {
                    <div class="p2-suggestion">
                        <strong>
                            @suggestion.DeviceId —
                            @suggestion.Action.Replace('_', ' ')
                        </strong>

                        <p>@suggestion.Reason</p>

                        <button class="p2-btn outline"
                                disabled="@busy"
                                @onclick="() => ApplySuggestionAsync(suggestion)">
                            APPLY SUGGESTION
                        </button>
                    </div>
                }

                @if (data.Suggestions.Count == 0)
                {
                    <p class="p2-muted">
                        No recommendation yet. Generate low-moisture
                        alerts or repeat manual commands.
                    </p>
                }
            </div>
        </section>
    </div>

    <div class="p2-grid">

        <section class="p2-panel">
            <div class="p2-title">
                <div>
                    <small>SORTED DICTIONARY</small>
                    <h2>Telemetry timeline</h2>
                </div>
                <span class="p2-tag">CHRONOLOGICAL</span>
            </div>

            <div class="p2-table-wrap">
                <table class="p2-table">
                    <thead>
                        <tr>
                            <th>TIME</th>
                            <th>DEVICE</th>
                            <th>METRIC</th>
                            <th>VALUE</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reading in data.Timeline.Take(15))
                        {
                            <tr>
                                <td>@reading.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td>@reading.DeviceId</td>
                                <td>@reading.Metric</td>
                                <td>@reading.DisplayValue</td>
                                <td class="@(reading.IsAlert ? "p2-danger" : "p2-accent")">
                                    @(reading.IsAlert ? "ALERT" : "NORMAL")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="p2-panel">
            <div class="p2-title">
                <div>
                    <small>COMMAND HISTORY</small>
                    <h2>Override audit trail</h2>
                </div>
                <span class="p2-tag">LATEST FIRST</span>
            </div>

            <div class="p2-scroll">
                @foreach (var command in data.Commands.Take(12))
                {
                    <div class="p2-command">
                        <strong>
                            @command.Action.Replace('_', ' ')
                            <span class="@(command.Undone ? "p2-muted" : "p2-accent")">
                                @(command.Undone ? "UNDONE" : "APPLIED")
                            </span>
                        </strong>

                        <small>
                            @command.DeviceId • @command.PreviousState
                            → @command.NewState
                        </small>

                        <small>
                            @command.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                        </small>
                    </div>
                }

                @if (data.Commands.Count == 0)
                {
                    <p class="p2-muted">
                        No override commands have been sent yet.
                    </p>
                }
            </div>
        </section>
    </div>

    <footer class="p2-footer">
        SMART-X / PART 2 SIMULATION
        <span>Refresh every 3 seconds • In-memory processing</span>
    </footer>
</div>

@code {
    private CommandStreamSnapshot data = new(
        new(), new(), new(), new(), new(),
        0, 0, 0, false, DateTimeOffset.UtcNow);

    private string search = "";
    private string categoryFilter = "All";
    private bool alertsOnly;
    private bool connected;
    private bool busy;
    private string message = "";

    private string selectedDevice = "ESP32-FARM-A";
    private string selectedAction = "PUMP_ON";

    private CancellationTokenSource? cancellation;

    private DeviceLiveStatus? SelectedDevice =>
        data.Devices.FirstOrDefault(d => d.DeviceId == selectedDevice);

    private List<DeviceLiveStatus> FilteredDevices => data.Devices
        .Where(d =>
            (categoryFilter == "All" || d.Category == categoryFilter) &&
            (!alertsOnly || d.ActiveAlerts > 0) &&
            (string.IsNullOrWhiteSpace(search) ||
             d.DeviceId.Contains(search, StringComparison.OrdinalIgnoreCase) ||
             d.Location.Contains(search, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private string[] AvailableActions => SelectedDevice?.Category switch
    {
        "Environmental" => ["PUMP_ON", "PUMP_OFF"],
        "Power" => ["RELAY_ON", "RELAY_OFF"],
        "Actuator" => ["VALVE_OPEN", "VALVE_CLOSE"],
        _ => []
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        cancellation = new CancellationTokenSource();
        _ = PollAsync(cancellation.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

            while (await timer.WaitForNextTickAsync(token))
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var next = await Http.GetFromJsonAsync<CommandStreamSnapshot>(
                "api/stream");

            if (next is not null)
                data = next;

            connected = true;

            if (SelectedDevice is null)
                selectedDevice = data.Devices.FirstOrDefault()?.DeviceId ?? "";

            ChooseDefaultAction();
        }
        catch (Exception ex)
            when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            connected = false;
            message = "Cannot reach the Smart-X API on http://localhost:5010.";
        }
    }

    private void ChooseDevice(string id)
    {
        selectedDevice = id;
        ChooseDefaultAction();
    }

    private void ChooseDefaultAction()
    {
        if (!AvailableActions.Contains(selectedAction))
            selectedAction = AvailableActions.FirstOrDefault() ?? "";
    }

    private async Task SendCommandAsync() =>
        await IssueCommandAsync(selectedDevice, selectedAction);

    private async Task ApplySuggestionAsync(ActionSuggestion suggestion)
    {
        ChooseDevice(suggestion.DeviceId);
        selectedAction = suggestion.Action;
        await IssueCommandAsync(suggestion.DeviceId, suggestion.Action);
    }

    private async Task IssueCommandAsync(string deviceId, string action)
    {
        busy = true;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "api/stream/commands",
                new DeviceCommandRequest(deviceId, action));

            message = response.IsSuccessStatusCode
                ? $"{action} applied to {deviceId}."
                : $"Command rejected: {await response.Content.ReadAsStringAsync()}";

            await RefreshAsync();
        }
        catch (HttpRequestException ex)
        {
            message = ex.Message;
            connected = false;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UndoAsync()
    {
        busy = true;

        try
        {
            using var response = await Http.PostAsync(
                "api/stream/undo", null);

            message = response.IsSuccessStatusCode
                ? "Most recent device override has been undone."
                : await response.Content.ReadAsStringAsync();

            await RefreshAsync();
        }
        catch (HttpRequestException ex)
        {
            message = ex.Message;
            connected = false;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SimulateAsync()
    {
        busy = true;

        try
        {
            using var response = await Http.PostAsync(
                "api/simulate", null);

            message = response.IsSuccessStatusCode
                ? "New telemetry queued. Alerts will be prioritised automatically."
                : await response.Content.ReadAsStringAsync();

            await RefreshAsync();
        }
        catch (HttpRequestException ex)
        {
            message = ex.Message;
            connected = false;
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose()
    {
        cancellation?.Cancel();
        cancellation?.Dispose();
    }
}

<style>
    .p2-page {
        background: #080d17;
        color: #eef5ff;
        min-height: 100vh;
        padding: 24px clamp(18px, 4vw, 60px);
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .p2-page * { box-sizing: border-box; }
    .p2-accent { color: #b7ff4a; }
    .p2-danger { color: #ff8b91; }
    .p2-muted { color: #91a3ba; font-size: 13px; line-height: 1.7; }

    .p2-header, .p2-brand, .p2-nav, .p2-hero,
    .p2-title, .p2-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }

    .p2-header {
        border-bottom: 1px solid #26364b;
        padding-bottom: 22px;
        flex-wrap: wrap;
    }


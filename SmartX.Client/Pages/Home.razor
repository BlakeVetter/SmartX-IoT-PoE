@page "/"
@using System.Globalization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using SmartX.Shared
@inject HttpClient Http
@implements IDisposable

<PageTitle>Smart-X | IoT Control Centre</PageTitle>

<div class="sx-page">

    <header class="sx-header">
        <div class="sx-brand">
            <div class="sx-logo">X</div>
            <div>
                <strong>SMART<span class="sx-green">-X</span></strong>
                <small>IOT OPERATIONS PLATFORM</small>
            </div>
        </div>

        <div class="sx-connection">
            <span class="sx-dot @(connected ? "on" : "off")"></span>
            @(connected ? "GATEWAY CONNECTED" : "GATEWAY OFFLINE")
        </div>
    </header>

    <section class="sx-hero">
        <div>
            <span class="sx-eyebrow">PART 01 / DATA INGESTION GATEWAY</span>
            <h1>Intelligent IoT <span class="sx-green">Monitoring.</span></h1>
            <p>
                Register devices, monitor typed sensor telemetry,
                detect anomalies and manage your IoT ecosystem.
            </p>
        </div>

        <button class="sx-primary"
                disabled="@busy"
                @onclick="SimulateAsync">
            @(busy ? "PROCESSING..." : "+ SIMULATE READINGS")
        </button>
    </section>

    <nav class="sx-navigation">
        <span class="active">01 / SENSOR INGESTION</span>
        <span>02 / COMMAND STREAM — PART 2</span>
        <span>03 / MESH TOPOLOGY — FINAL POE</span>
    </nav>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="sx-notice" role="status">@message</div>
    }

    <section class="sx-stats">
        <div class="sx-stat">
            <small>REGISTERED DEVICES</small>
            <strong>@data.Devices.Count</strong>
            <span>Available IoT nodes</span>
        </div>

        <div class="sx-stat">
            <small>TELEMETRY PACKETS</small>
            <strong>@data.TotalPackets.ToString("N0")</strong>
            <span>Successfully ingested</span>
        </div>

        <div class="sx-stat">
            <small>ANOMALY ALERTS</small>
            <strong class="sx-red">@data.TotalAlerts</strong>
            <span>Abnormal sensor readings</span>
        </div>

        <div class="sx-stat">
            <small>DEVICE ATTACHMENTS</small>
            <strong>@data.Uploads.Count</strong>
            <span>Configuration and media</span>
        </div>
    </section>

    <div class="sx-grid">

        <section class="sx-panel">
            <div class="sx-panel-heading">
                <div>
                    <small>DEVICE MANAGEMENT</small>
                    <h2>Register a sensor</h2>
                </div>
                <span class="sx-tag">01 / INTAKE</span>
            </div>

            <div class="sx-form">
                <label>
                    MAC ADDRESS / DEVICE IDENTIFIER
                    <input @bind="newDeviceId"
                           placeholder="ESP32-ROOM-01" />
                </label>

                <label>
                    DEPLOYMENT LOCATION
                    <input @bind="newLocation"
                           placeholder="Hydroponic Farm / Zone C" />
                </label>

                <label>
                    SENSOR CATEGORY
                    <select @bind="newCategory">
                        <option value="Environmental">Environmental</option>
                        <option value="Power">Power</option>
                        <option value="Actuator">Actuator</option>
                    </select>
                </label>

                <button class="sx-secondary"
                        disabled="@busy"
                        @onclick="RegisterAsync">
                    + REGISTER DEVICE
                </button>
            </div>

            <div class="sx-divider"></div>

            <div class="sx-panel-heading">
                <div>
                    <small>DEVICE REGISTRY</small>
                    <h2>Connected devices</h2>
                </div>
                <span class="sx-tag">@data.Devices.Count NODES</span>
            </div>

            <div class="sx-device-list">
                @foreach (var device in data.Devices)
                {
                    <button class="sx-device @(selectedDevice == device.DeviceId ? "selected" : "")"
                            @onclick="() => selectedDevice = device.DeviceId">

                        <span class="sx-device-icon">◈</span>

                        <span class="sx-device-name">
                            <strong>@device.DeviceId</strong>
                            <small>@device.Location</small>
                        </span>

                        <span class="sx-device-category">
                            @device.Category
                        </span>
                    </button>
                }
            </div>
        </section>

        <section class="sx-panel">
            <div class="sx-panel-heading">
                <div>
                    <small>LIVE SENSOR SIGNALS</small>
                    <h2>Telemetry overview</h2>
                </div>
                <span class="sx-tag">REFRESH / 5S</span>
            </div>

            @foreach (var reading in data.RecentReadings
                .Where(r => r.NumericValue.HasValue).Take(5))
            {
                <div class="sx-reading">
                    <div class="sx-reading-top">
                        <div>
                            <strong>@reading.DeviceId</strong>
                            <small>@reading.Metric</small>
                        </div>

                        <b class="@(reading.IsAlert ? "sx-red" : "sx-green")">
                            @reading.DisplayValue
                        </b>
                    </div>

                    <div class="sx-progress">
                        <div class="sx-progress-fill @(reading.IsAlert ? "alert" : "")"
                             style="@($"width:{BarPercent(reading)}%")">
                        </div>
                    </div>
                </div>
            }

            @if (!data.RecentReadings.Any(r => r.NumericValue.HasValue))
            {
                <p class="sx-muted">No numeric readings available yet.</p>
            }

            <div class="sx-divider"></div>

            <div class="sx-panel-heading">
                <div>
                    <small>MANUAL DATA INJECTION</small>
                    <h2>Send telemetry</h2>
                </div>
            </div>

            <div class="sx-form">
                <label>
                    TARGET DEVICE
                    <select @bind="selectedDevice">
                        @foreach (var device in data.Devices)
                        {
                            <option value="@device.DeviceId">
                                @device.DeviceId
                            </option>
                        }
                    </select>
                </label>

                <label>
                    TELEMETRY DATA TYPE
                    <select @bind="valueType">
                        <option value="float">Float — Soil moisture</option>
                        <option value="int">Integer — Power usage</option>
                        <option value="bool">Boolean — Valve state</option>
                    </select>
                </label>

                <label>
                    SENSOR VALUE
                    <input @bind="valueText"
                           placeholder="18.5 / 850 / true" />
                </label>

                <button class="sx-secondary"
                        disabled="@busy"
                        @onclick="SendPacketAsync">
                    SEND TELEMETRY
                </button>
            </div>
        </section>
    </div>

    <div class="sx-grid sx-bottom">

        <section class="sx-panel">
            <div class="sx-panel-heading">
                <div>
                    <small>INGESTION HISTORY</small>
                    <h2>Recent sensor packets</h2>
                </div>
                <span class="sx-tag">LATEST READINGS</span>
            </div>

            <div class="sx-table-wrap">
                <table class="sx-table">
                    <thead>
                        <tr>
                            <th>TIME</th>
                            <th>DEVICE</th>
                            <th>METRIC</th>
                            <th>VALUE</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reading in data.RecentReadings.Take(15))
                        {
                            <tr>
                                <td>@reading.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td>@reading.DeviceId</td>
                                <td>@reading.Metric</td>
                                <td>@reading.DisplayValue</td>
                                <td>
                                    <span class="@(reading.IsAlert ? "sx-red" : "sx-green")">
                                        @(reading.IsAlert ? "ALERT" : "NORMAL")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="sx-panel">
            <div class="sx-panel-heading">
                <div>
                    <small>DEVICE ATTACHMENTS</small>
                    <h2>Upload files</h2>
                </div>
                <span class="sx-tag">MAX 5 MB</span>
            </div>

            <p class="sx-muted">
                Select a sensor from the registry and upload
                a deployment photo, configuration file or log.
            </p>

            <div class="sx-upload">
                <InputFile OnChange="UploadAsync"
                           accept=".png,.jpg,.jpeg,.pdf,.txt,.log" />
            </div>

            <div class="sx-divider"></div>

            @foreach (var file in data.Uploads.Take(6))
            {
                <div class="sx-uploaded-file">
                    <span>▤</span>
                    <div>
                        <strong>@file.OriginalFileName</strong>
                        <small>@file.DeviceId</small>
                    </div>
                </div>
            }

            @if (data.Uploads.Count == 0)
            {
                <p class="sx-muted">No attachments uploaded yet.</p>
            }
        </section>
    </div>

    <footer class="sx-footer">
        SMART-X / SIMULATED IOT GATEWAY
        <span>ASP.NET CORE + BLAZOR WEBASSEMBLY</span>
    </footer>
</div>

@code {
    private DashboardSnapshot data =
        new(new(), new(), new(), 0, 0, DateTimeOffset.UtcNow);

    private string newDeviceId = "";
    private string newLocation = "";
    private string newCategory = "Environmental";

    private string selectedDevice = "ESP32-FARM-A";
    private string valueType = "float";
    private string valueText = "18.5";

    private string message = "";
    private bool connected;
    private bool busy;

    private CancellationTokenSource? cancellation;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        cancellation = new CancellationTokenSource();
        _ = PollAsync(cancellation.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            using var timer =
                new PeriodicTimer(TimeSpan.FromSeconds(5));

            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var snapshot =
                await Http.GetFromJsonAsync<DashboardSnapshot>(
                    "api/dashboard");

            if (snapshot is not null)
                data = snapshot;

            connected = true;

            if (!data.Devices.Any(
                d => d.DeviceId == selectedDevice))
            {
                selectedDevice =
                    data.Devices.FirstOrDefault()?.DeviceId ?? "";
            }
        }
        catch (HttpRequestException)
        {
            connected = false;
        }
        catch (System.Text.Json.JsonException)
        {
            connected = false;
        }
    }

    private async Task RegisterAsync()
    {
        bool success = await SendRequestAsync(
            () => Http.PostAsJsonAsync(
                "api/devices",
                new RegisterDeviceRequest(
                    newDeviceId,
                    newLocation,
                    newCategory)),
            "Sensor registered successfully.");

        if (success)
        {
            newDeviceId = "";
            newLocation = "";
        }
    }

    private async Task SimulateAsync()
    {
        await SendRequestAsync(
            () => Http.PostAsync("api/simulate", null),
            "New simulated sensor readings generated.");
    }

    private async Task SendPacketAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedDevice))
        {
            message = "Select a registered device first.";
            return;
        }

        if (valueType == "float" &&
            float.TryParse(
                valueText,
                NumberStyles.Float,
                CultureInfo.InvariantCulture,
                out var floatValue))
        {
            await SendRequestAsync(
                () => Http.PostAsJsonAsync(
                    "api/telemetry/float",
                    new TelemetryPacket<float>(
                        selectedDevice,
                        "Soil Moisture (%)",
                        floatValue)),
                "Float telemetry accepted.");
        }
        else if (valueType == "int" &&
                 int.TryParse(valueText, out var intValue))
        {
            await SendRequestAsync(
                () => Http.PostAsJsonAsync(
                    "api/telemetry/int",
                    new TelemetryPacket<int>(
                        selectedDevice,
                        "Power Usage (W)",
                        intValue)),
                "Integer telemetry accepted.");
        }
        else if (valueType == "bool" &&
                 bool.TryParse(valueText, out var boolValue))
        {
            await SendRequestAsync(
                () => Http.PostAsJsonAsync(
                    "api/telemetry/bool",
                    new TelemetryPacket<bool>(
                        selectedDevice,
                        "Valve Open",
                        boolValue)),
                "Boolean telemetry accepted.");
        }
        else
        {
            message = "Invalid value. Use 18.5, 850 or true/false.";
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(selectedDevice))
        {
            message = "Select a registered device first.";
            return;
        }

        try
        {
            using var content = new MultipartFormDataContent();

            content.Add(
                new StringContent(selectedDevice),
                "deviceId");

            using var fileContent = new StreamContent(
                e.File.OpenReadStream(5 * 1024 * 1024));

            content.Add(fileContent, "file", e.File.Name);

            await SendRequestAsync(
                () => Http.PostAsync("api/uploads", content),
                "File uploaded successfully.");
        }
        catch (Exception ex)
        {
            message = $"Upload failed: {ex.Message}";
        }
    }

    private async Task<bool> SendRequestAsync(
        Func<Task<HttpResponseMessage>> request,
        string successMessage)
    {
        busy = true;

        try
        {
            using var response = await request();

            if (!response.IsSuccessStatusCode)
            {
                message =
                    $"API error {(int)response.StatusCode}: " +
                    await response.Content.ReadAsStringAsync();

                return false;
            }

            message = successMessage;
            await RefreshAsync();

            return true;
        }
        catch (Exception ex)
        {
            connected = false;
            message = $"Connection problem: {ex.Message}";
            return false;
        }
        finally
        {
            busy = false;
        }
    }

    private static int BarPercent(TelemetryReading reading)
    {
        double maximum = reading.Metric.Contains(
            "power",
            StringComparison.OrdinalIgnoreCase)
                ? 1000
                : 100;

        return (int)Math.Clamp(
            (reading.NumericValue ?? 0) / maximum * 100,
            0,
            100);
    }

    public void Dispose()
    {
        cancellation?.Cancel();
        cancellation?.Dispose();
    }
}

<style>
    .sx-page {
        background: #080d17;
        min-height: 100vh;
        padding: 28px clamp(18px, 4vw, 64px);
        color: #e9f2ff;

@page "/"
@using System.Globalization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using SmartX.Shared
@inject HttpClient Http
@implements IDisposable

<PageTitle>Smart-X | Sensor Ingestion</PageTitle>

<div class="sx-app">

    <header class="sx-header">
        <a href="/" class="sx-brand">
            <span class="sx-logo">X</span>
            <span>
                SMART<span class="sx-green">-X</span>
                <small>IOT OPERATIONS PLATFORM</small>
            </span>
        </a>

        <div class="sx-status">
            <span class="sx-status-dot @(connected ? "online" : "offline")"></span>
            @(connected ? "GATEWAY CONNECTED" : "GATEWAY OFFLINE")
        </div>
    </header>

    <nav class="sx-nav">
        <NavLink href="/" Match="NavLinkMatch.All">
            01 / SENSOR INGESTION
        </NavLink>

        <NavLink href="/command-stream">
            02 / COMMAND STREAM
        </NavLink>

        <NavLink href="/topology">
            03 / MESH TOPOLOGY
        </NavLink>
    </nav>

    <section class="sx-hero">
        <div>
            <span class="sx-eyebrow">
                PART 01 / DATA INGESTION GATEWAY
            </span>

            <h1>
                Intelligent IoT
                <span class="sx-green">Monitoring.</span>
            </h1>

            <p>
                Register ESP32 devices, monitor sensor telemetry,
                detect anomalies and manage your intelligent
                IoT ecosystem in real time.
            </p>
        </div>

        <button class="sx-btn sx-primary"
                disabled="@busy"
                @onclick="SimulateAsync">
            + SIMULATE READINGS
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="sx-notice" role="status">
            @message
        </div>
    }

    <section class="sx-stats">

        <div class="sx-stat">
            <small>REGISTERED DEVICES</small>
            <strong>@data.Devices.Count</strong>
            <span>Active sensor registry</span>
        </div>

        <div class="sx-stat">
            <small>TELEMETRY PACKETS</small>
            <strong>@data.TotalPackets.ToString("N0")</strong>
            <span>Successfully ingested</span>
        </div>

        <div class="sx-stat">
            <small>ANOMALY ALERTS</small>
            <strong class="sx-red">@data.TotalAlerts</strong>
            <span>Abnormal sensor readings</span>
        </div>

        <div class="sx-stat">
            <small>DEVICE ATTACHMENTS</small>
            <strong>@data.Uploads.Count</strong>
            <span>Uploaded files and logs</span>
        </div>

    </section>

    <div class="sx-grid">

        <section class="sx-panel">
            <div class="sx-panel-header">
                <div>
                    <small>DEVICE MANAGEMENT</small>
                    <h2>Register a sensor</h2>
                </div>
                <span class="sx-tag">DEVICE INTAKE</span>
            </div>

            <div class="sx-form">

                <label for="device-id">DEVICE MAC / IDENTIFIER</label>
                <input id="device-id"
                       @bind="newDeviceId"
                       placeholder="ESP32-ROOM-01" />

                <label for="device-location">DEPLOYMENT LOCATION</label>
                <input id="device-location"
                       @bind="newLocation"
                       placeholder="Hydroponic Farm / Zone C" />

                <label for="device-category">SENSOR CATEGORY</label>
                <select id="device-category" @bind="newCategory">
                    <option value="Environmental">Environmental</option>
                    <option value="Power">Power Consumption</option>
                    <option value="Actuator">Actuator</option>
                </select>

                <button class="sx-btn sx-secondary"
                        disabled="@busy"
                        @onclick="RegisterAsync">
                    + REGISTER DEVICE
                </button>
            </div>

            <div class="sx-divider"></div>

            <div class="sx-panel-header">
                <div>
                    <small>DEVICE REGISTRY</small>
                    <h2>Registered sensors</h2>
                </div>
                <span class="sx-tag">@data.Devices.Count NODES</span>
            </div>

            <div class="sx-device-list">
                @foreach (var device in data.Devices)
                {
                    <button class="sx-device @(selectedDevice == device.DeviceId ? "selected" : "")"
                            @onclick="() => SelectDevice(device.DeviceId)">

                        <span class="sx-device-icon">◈</span>

                        <span class="sx-device-info">
                            <strong>@device.DeviceId</strong>
                            <small>@device.Location</small>
                        </span>

                        <span class="sx-device-category">
                            @device.Category
                        </span>
                    </button>
                }

                @if (data.Devices.Count == 0)
                {
                    <p class="sx-muted">No registered devices found.</p>
                }
            </div>
        </section>

        <section class="sx-panel">
            <div class="sx-panel-header">
                <div>
                    <small>TELEMETRY MONITOR</small>
                    <h2>Live sensor readings</h2>
                </div>
                <span class="sx-tag">AUTO REFRESH / 5S</span>
            </div>

            @foreach (var reading in data.RecentReadings
                .Where(r => r.NumericValue.HasValue)
                .Take(5))
            {
                <div class="sx-reading">
                    <div class="sx-reading-info">
                        <div>
                            <strong>@reading.DeviceId</strong>
                            <small>@reading.Metric</small>
                        </div>

                        <span class="@(reading.IsAlert ? "sx-red" : "sx-green")">
                            @reading.DisplayValue
                        </span>
                    </div>

                    <div class="sx-progress">
                        <div class="sx-progress-bar @(reading.IsAlert ? "alert" : "")"
                             style="@($"width:{BarPercent(reading)}%")">
                        </div>
                    </div>
                </div>
            }

            @if (!data.RecentReadings.Any(r => r.NumericValue.HasValue))
            {
                <p class="sx-muted">
                    No numeric readings available.
                    Generate telemetry to begin monitoring.
                </p>
            }

            <div class="sx-divider"></div>

            <div class="sx-panel-header">
                <div>
                    <small>MANUAL DATA INJECTION</small>
                    <h2>Send telemetry</h2>
                </div>
                <span class="sx-tag">GENERIC PAYLOAD</span>
            </div>

            <div class="sx-form">

                <label for="target-device">TARGET DEVICE</label>

                <select id="target-device" @bind="selectedDevice">
                    @foreach (var device in data.Devices)
                    {
                        <option value="@device.DeviceId">
                            @device.DeviceId
                        </option>
                    }
                </select>

                <label for="telemetry-type">DATA TYPE</label>

                <select id="telemetry-type" @bind="valueType">
                    <option value="float">Float — Soil Moisture</option>
                    <option value="int">Integer — Power Usage</option>
                    <option value="bool">Boolean — Valve State</option>
                </select>

                <label for="sensor-value">SENSOR VALUE</label>

                <input id="sensor-value"
                       @bind="valueText"
                       placeholder="18.5 / 850 / true" />

                <button class="sx-btn sx-secondary"
                        disabled="@busy"
                        @onclick="SendTelemetryAsync">
                    SEND TELEMETRY PACKET
                </button>
            </div>
        </section>
    </div>

    <div class="sx-grid sx-bottom">

        <section class="sx-panel">
            <div class="sx-panel-header">
                <div>
                    <small>TELEMETRY HISTORY</small>
                    <h2>Recent sensor packets</h2>
                </div>
                <span class="sx-tag">LATEST READINGS</span>
            </div>

            <div class="sx-table-wrapper">
                <table class="sx-table">
                    <thead>
                        <tr>
                            <th>TIMESTAMP</th>
                            <th>DEVICE</th>
                            <th>METRIC</th>
                            <th>VALUE</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reading in data.RecentReadings.Take(20))
                        {
                            <tr>
                                <td>
                                    @reading.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")
                                </td>
                                <td>@reading.DeviceId</td>
                                <td>@reading.Metric</td>
                                <td>@reading.DisplayValue</td>
                                <td>
                                    <span class="@(reading.IsAlert ? "sx-red" : "sx-green")">
                                        @(reading.IsAlert ? "ALERT" : "NORMAL")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (data.RecentReadings.Count == 0)
                {
                    <p class="sx-muted">No telemetry packets recorded.</p>
                }
            </div>
        </section>

        <section class="sx-panel">
            <div class="sx-panel-header">
                <div>
                    <small>DEVICE ATTACHMENTS</small>
                    <h2>Upload configuration</h2>
                </div>
                <span class="sx-tag">MAX 5 MB</span>
            </div>

            <p class="sx-muted">
                Select a registered sensor, then upload
                an installation image, configuration
                file or diagnostic log.
            </p>

            <div class="sx-upload">
                <InputFile OnChange="UploadAsync"
                           accept=".png,.jpg,.jpeg,.pdf,.txt,.log" />
            </div>

            <div class="sx-divider"></div>

            <h3 class="sx-subheading">Recent uploads</h3>

            @foreach (var file in data.Uploads.Take(8))
            {
                <div class="sx-file">
                    <span class="sx-file-icon">▤</span>

                    <div>
                        <strong>@file.OriginalFileName</strong>
                        <small>@file.DeviceId</small>
                    </div>
                </div>
            }

            @if (data.Uploads.Count == 0)
            {
                <p class="sx-muted">No attachments uploaded yet.</p>
            }
        </section>
    </div>

    <footer class="sx-footer">
        <span>SMART-X / SENSOR INGESTION GATEWAY</span>
        <span>ASP.NET CORE + BLAZOR WEBASSEMBLY</span>
    </footer>
</div>

@code {
    private DashboardSnapshot data = new(
        new List<IoTDevice>(),
        new List<TelemetryReading>(),
        new List<UploadInfo>(),
        0,
        0,
        DateTimeOffset.UtcNow
    );

    private string newDeviceId = "";
    private string newLocation = "";
    private string newCategory = "Environmental";

    private string selectedDevice = "ESP32-FARM-A";
    private string valueType = "float";
    private string valueText = "18.5";

    private string message = "";

    private bool connected;
    private bool busy;

    private CancellationTokenSource? cancellation;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        cancellation = new CancellationTokenSource();

        _ = PollAsync(cancellation.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(
                TimeSpan.FromSeconds(5));

            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component navigation stops the polling loop.
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var snapshot =
                await Http.GetFromJsonAsync<DashboardSnapshot>(
                    "api/dashboard");

            if (snapshot is not null)
            {
                data = snapshot;
            }

            connected = true;

            if (!data.Devices.Any(d =>
                d.DeviceId == selectedDevice))
            {
                selectedDevice =
                    data.Devices.FirstOrDefault()?.DeviceId ?? "";
            }
        }
        catch (HttpRequestException)
        {
            connected = false;
        }
        catch (System.Text.Json.JsonException)
        {
            connected = false;
        }
    }

    private void SelectDevice(string deviceId)
    {
        selectedDevice = deviceId;
    }

    private async Task RegisterAsync()
    {
        string requestedId = newDeviceId.Trim();

        bool success = await SendRequestAsync(
            () => Http.PostAsJsonAsync(
                "api/devices",
                new RegisterDeviceRequest(
                    requestedId,
                    newLocation,
                    newCategory)),
            "Sensor registered successfully."
        );

        if (success)
        {
            selectedDevice = requestedId.ToUpperInvariant();
            newDeviceId = "";
            newLocation = "";
        }
    }

    private async Task SimulateAsync()
    {
        await SendRequestAsync(
            () => Http.PostAsync("api/simulate", null),
            "New sensor readings generated successfully."
        );
    }

    private async Task SendTelemetryAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedDevice))
        {
            message = "Please select a registered sensor.";
            return;
        }

        switch (valueType)
        {
            case "float":
                if (float.TryParse(
                    valueText,
                    NumberStyles.Float,
                    CultureInfo.InvariantCulture,
                    out float moisture) && float.IsFinite(moisture))
                {
                    await SendRequestAsync(
                        () => Http.PostAsJsonAsync(
                            "api/telemetry/float",
                            new TelemetryPacket<float>(
                                selectedDevice,
                                "Soil Moisture (%)",
                                moisture)),
                        "Float telemetry submitted."
                    );
                }
                else
                {
                    message = "Enter a valid float, such as 18.5.";
                }
                break;

            case "int":
                if (int.TryParse(valueText, out int watts))
                {
                    await SendRequestAsync(
                        () => Http.PostAsJsonAsync(
                            "api/telemetry/int",
                            new TelemetryPacket<int>(
                                selectedDevice,
                                "Power Usage (W)",
                                watts)),
                        "Integer telemetry submitted."
                    );
                }
                else
                {
                    message = "Enter a valid integer, such as 850.";
                }
                break;

            case "bool":
                if (bool.TryParse(valueText, out bool valveOpen))
                {
                    await SendRequestAsync(
                        () => Http.PostAsJsonAsync(
                            "api/telemetry/bool",
                            new TelemetryPacket<bool>(
                                selectedDevice,
                                "Valve Open",
                                valveOpen)),
                        "Boolean telemetry submitted."
                    );
                }
                else
                {
                    message = "Enter true or false.";
                }
                break;
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(selectedDevice))
        {
            message = "Select a sensor before uploading.";
            return;
        }

        try
        {
            using var content = new MultipartFormDataContent();

            content.Add(
                new StringContent(selectedDevice),
                "deviceId"
            );

            using var fileStream = e.File.OpenReadStream(
                5 * 1024 * 1024);

            using var fileContent = new StreamContent(fileStream);

            content.Add(fileContent, "file", e.File.Name);

            await SendRequestAsync(
                () => Http.PostAsync("api/uploads", content),
                "File uploaded successfully."
            );
        }
        catch (Exception ex)
        {
            message = $"Upload failed: {ex.Message}";
        }
    }

    private async Task<bool> SendRequestAsync(
        Func<Task<HttpResponseMessage>> request,
        string successMessage)
    {
        busy = true;

        try
        {
            using var response = await request();

            if (!response.IsSuccessStatusCode)
            {
                string details =
                    await response.Content.ReadAsStringAsync();

                message = $"API error: {details}";
                return false;
            }

            message = successMessage;

            await RefreshAsync();

            return true;
        }
        catch (Exception ex)
        {
            connected = false;
            message = $"Connection error: {ex.Message}";

            return false;
        }
        finally
        {
            busy = false;
        }
    }

    private static int BarPercent(TelemetryReading reading)
    {
        double maximum =
            reading.Metric.Contains(
                "power",
                StringComparison.OrdinalIgnoreCase)
                ? 1000
                : 100;

        return (int)Math.Clamp(
            (reading.NumericValue ?? 0) / maximum * 100,
            0,
            100
        );
    }

    public void Dispose()
    {
        cancellation?.Cancel();
        cancellation?.Dispose();
    }
}

